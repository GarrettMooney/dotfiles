{
  "env": {
    "ENABLE_TOOL_SEARCH": "true"
  },
  "permissions": {
    "deny": [
      "Read(~/.tokens)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | { read -r f; case \"$f\" in *.py) ruff format \"$f\" >/dev/null 2>&1; ruff check --fix \"$f\" >/dev/null 2>&1 ;; esac; }"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/tmux-claude-title.sh working"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"${CLAUDE_TITLE_GEN:-}\" ] && afplay /System/Library/Sounds/Glass.aiff >/dev/null 2>&1 &"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/tmux-claude-title.sh done"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"${CLAUDE_TITLE_GEN:-}\" ] && afplay /System/Library/Sounds/Ping.aiff >/dev/null 2>&1 &"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/tmux-claude-title.sh waiting"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r \".tool_input.command // empty\" | grep -qE \"(~|\\\\\\$HOME|$HOME)/\\.tokens\" && echo \"{\\\"hookSpecificOutput\\\":{\\\"hookEventName\\\":\\\"PreToolUse\\\",\\\"permissionDecision\\\":\\\"deny\\\",\\\"permissionDecisionReason\\\":\\\"~/.tokens is blocked by user policy\\\"}}\" || true"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@superpowers-marketplace": true,
    "mgrep@Mixedbread-Grep": true,
    "evals-skills@hamelsmu-evals-skills": true,
    "frontend-slides@frontend-slides": true,
    "astral@astral-sh": true,
    "gog-cli@intellectronica-skills": true,
    "elements-of-style@superpowers-marketplace": true
  },
  "extraKnownMarketplaces": {
    "hamelsmu-evals-skills": {
      "source": {
        "source": "github",
        "repo": "hamelsmu/evals-skills"
      }
    },
    "frontend-slides": {
      "source": {
        "source": "github",
        "repo": "zarazhangrui/frontend-slides"
      }
    },
    "astral-sh": {
      "source": {
        "source": "github",
        "repo": "astral-sh/claude-code-plugins"
      }
    },
    "intellectronica-skills": {
      "source": {
        "source": "github",
        "repo": "intellectronica/agent-skills"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark-daltonized",
  "autoCompactEnabled": false,
  "skipAutoPermissionPrompt": true,
  "remoteControlAtStartup": true
}
